{
  "name": "monkeytype_tracker",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm run build:frontend && electron .",
    "lint": "npm --prefix frontend run lint",
    "package": "npm run build:frontend && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younesRekik15/monkeytype-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/younesRekik15/monkeytype-tracker/issues"
  },
  "homepage": "https://github.com/younesRekik15/monkeytype-tracker#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.yourname.monkeytypewidget",
    "productName": "Monkeytype Widget",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "back",
        "to": "back",
        "filter": [
          "**/*",
          "!.env"
        ]
      },
      {
        "from": ".env.example",
        "to": ".env"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
